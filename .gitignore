node_modules/
dist/
*.log

# ============================================================
#  deploy/server 是部署件的唯一源（入库），但下面这些是每台机器自己的：
# ============================================================

# 本机实跑配置：含本机地址。模板 config.ini.example 才入库
deploy/server/config.ini
# 服务器侧那份可能被填了仓库 token，更不能进仓库
deploy_ci/server/config.ini

# 应用镜像包：build-image.sh 生成，体积大，不入库
deploy/server/image/

# 打包时自动生成的版本戳
deploy/server/VERSION.txt

# 运行时数据 / 渲染产物，每台机器自己产生
deploy/server/roles/center/data/
deploy/server/roles/agent/data/
deploy/server/roles/gateway/conf.d/

# 本地工作记忆：含内网地址、主机名、排查草稿，不进仓库
.workbuddy/

# 本机删除文件时的回收站（部分环境把 rm 重定向到这里）
.Trash-0/
