# ============================================================
#  配置模板。不要直接改这个文件，改 config.ini。
#
#  用法：第一次部署时执行
#      ./deploy.sh init
#  它会把这个文件复制成 config.ini，之后只改 config.ini。
#  没有 config.ini 时，任何 deploy.sh 命令也会自动从本模板生成一份。
#
#  换机器、加机器：把新机器的 config.ini 里 REGISTRY 改成注册中心那台的地址。
# ============================================================

# ---------- 镜像从哪拉 ----------
#  应用镜像由 CI 构建好推到 Docker Hub，服务器只负责拉，不在本地编译。
#  IMAGE_REPO 的账号部分必须与 .github/workflows/release.yml 里的
#  DOCKERHUB_NAMESPACE 一致（也就是密钥 DOCKER_USERNAME 那个账号），
#  否则镜像推到一个账号、这边去另一个账号拉，一定报 not found。
#
#  正式部署请钉具体版本，不要长期用 latest —— 出问题时才知道线上是哪个版本。
#  每次发布后 release.sh 会打印该填什么，形如 v20261021-104730。
IMAGE_REPO=wttcvs/consul-demo
IMAGE_TAG=latest

# ---------- 私有仓库才要填 ----------
#  公开仓库留空。填了就会在拉镜像前先 docker login。
#  填了 token 记得 chmod 600 config.ini。
#DOCKER_USERNAME=
#DOCKER_TOKEN=

# ---------- 注册中心在哪 ----------
#   一台机器上装注册中心时：这一行留空（它自己就是注册中心）
#   其它机器：填注册中心那台的内网地址，例：http://192.168.1.10:8500
#   注意：这个地址所有业务机都要能访问到。
REGISTRY=http://127.0.0.1:8500

# ---------- 本机对外地址 ----------
#   留空 = 脚本自动探测本机内网 IP，一般不用管。
#   探测不准时（多网卡、虚拟机 NAT）才手工填，例：192.168.1.11
MY_IP=

# ---------- 应用端口 ----------
#   每台机器同一个端口即可（不同机器互不影响）。
#   同一台机器要起第二个实例：执行 ./deploy.sh service 2，会自动用 3021。
APP_PORT=3020

# ---------- 网关对外端口 ----------
#   nginx 监听哪个端口把流量转给后端。
SITE_PORT=8088

# ---------- nginx 配置目录 ----------
#   留空 = 自动判定（推荐，一般不用填）：
#     1. 默认用 <当前用户家目录>/nginx/conf.d
#     2. 若 nginx 没有 include 这个默认目录，改用 nginx 自己的 conf.d
#        （从 nginx.conf 的 include 里推，推不出按 /etc/nginx/conf.d）
#   想固定到别处再填：相对路径按部署目录算（例 ../nginx/conf.d），也可写绝对路径。
#   注意：sudo 下会按真实调用者（SUDO_USER）的家目录算，不是 /root。
NGINX_CONF_DIR=

# ---------- 服务名 ----------
#   应用注册到注册中心时用的名字，也是 nginx 找后端的依据。
#   多套环境共用一台注册中心时才需要改。
SERVICE_NAME=consul-demo
