# 把注册中心里的服务列表，变成 nginx 能读的后端地址列表。
# 服务增减时这里会自动重写，不需要人来改。
#
# 用到的标签：
#   服务带 web 标签  -> 才会被写进地址列表（不是所有注册上来的都该接收流量）

{{ range services }}
{{ if in .Tags "web" }}
upstream {{ .Name }} {
{{ range service .Name }}
  server {{ .Address }}:{{ .Port }} max_fails=2 fail_timeout=2s;
{{ end }}
}
{{ end }}
{{ end }}
