# ============================================================
#  cluster.env —— 演练环境配置，只改这一个文件
#
#  所有脚本自动 source 本文件。每个值都写成 ${VAR:-默认值}，
#  所以也能临时用环境变量覆盖，例如：
#      REPLICAS=4 ./scale-out.sh
#      IMAGE=wttcvs/consul-demo:v20261023-101500 ./install-single.sh
# ============================================================

# ---------- 节点 IP ----------
# 集群成员是动态的：新机器靠 K3S_URL + K3S_TOKEN 加入，成员表在 etcd 里。
# 这个文件**不再维护节点清单**——加第 4、5、10 台都不用改这里。
# 只有 NODE1_IP 是「引导用」：首次安装时确定 --node-ip 和证书 SAN。
# 其它节点的实际 IP 由 join-server.sh 按「到 apiserver 的路由」自动探测。
#
# 演练环境已占用：.8/.9/.10 = 三台 k3s（旧方案）、.11 = nginx 网关、.12 = k3d
NODE1_IP="${NODE1_IP:-10.0.3.13}"

# ---------- 端口 ----------
K3S_API_PORT="${K3S_API_PORT:-6443}"   # k3s apiserver
NODE_PORT="${NODE_PORT:-30080}"        # Service nodePort，所有节点都监听
HTTP_PORT="${HTTP_PORT:-8080}"         # nginx 对外入口（80 不动）

# ---------- 工作负载 ----------
IMAGE="${IMAGE:-wttcvs/consul-demo:v20261022-172323}"
NS="${NS:-default}"
DEPLOY="${DEPLOY:-consul-demo}"
CONTAINER="${CONTAINER:-app}"

# 副本数。注意：它**不会**随节点数自动变。
#   副本数 3 + 节点 3  → 1-1-1
#   副本数 3 + 节点 10 → 只有 3 台承载流量（多了 7 台白加）
# 加机器后要扩副本：REPLICAS=4 ./scale-out.sh，或
#   kubectl -n default scale deploy/consul-demo --replicas=4
REPLICAS="${REPLICAS:-3}"
