# ============================================================
#  cluster.env —— 演练环境配置，只改这一个文件
#
#  用法：所有脚本自动从本文件读取，不需要 export
#  注意：改完 IP 后，三台机器上的这个文件必须一致
#        （脚本只读自己那台，但 scale-out 会用到三个 IP）
# ============================================================

# ---------- 节点 IP ----------
# 演练环境已占用：.8/.9/.10 = 三台 k3s（旧方案）、.11 = nginx 网关、.12 = k3d
# 本次演练：node1 = .13（当前这台 k3s-t1）
#          node2 / node3 建好后按实际 IP 改，三台上的这个文件必须一致
NODE1_IP=10.0.3.13
NODE2_IP=10.0.3.14
NODE3_IP=10.0.3.15

# ---------- 端口 ----------
K3S_API_PORT=6443          # k3s apiserver
NODE_PORT=30080            # Service nodePort，三台节点都会监听
HTTP_PORT=8080             # nginx 对外入口（80 不动）

# ---------- 工作负载 ----------
IMAGE=wttcvs/consul-demo:v20261022-172323
NS=default
DEPLOY=consul-demo
CONTAINER=app
REPLICAS=3
